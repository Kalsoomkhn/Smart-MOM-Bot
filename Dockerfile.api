FROM debian:bookworm-slim AS whisper-builder
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates cmake curl git build-essential \
  && rm -rf /var/lib/apt/lists/*
RUN git clone --depth 1 --branch b4938 https://github.com/ggml-org/whisper.cpp.git /whisper.cpp \
  && cmake -S /whisper.cpp -B /whisper.cpp/build -DBUILD_SHARED_LIBS=OFF \
  && cmake --build /whisper.cpp/build --config Release -j2
RUN mkdir -p /models \
  && curl -L --fail --retry 3 -o /models/ggml-small.en-tdrz.bin \
    https://huggingface.co/akashmjn/tinydiarize-whisper.cpp/resolve/main/ggml-small.en-tdrz.bin \
  && echo "b6c6e7e89af1a35c08e6de56b66ca6a02a2fdfa1  /models/ggml-small.en-tdrz.bin" | sha1sum -c -

FROM node:22-bookworm-slim
WORKDIR /app
COPY package*.json ./
RUN npm ci --omit=dev
COPY server ./server
COPY --from=whisper-builder /whisper.cpp/build/bin/whisper-cli /app/tools/whisper/whisper-cli
COPY --from=whisper-builder /models/ggml-small.en-tdrz.bin /app/models/ggml-small.en-tdrz.bin
EXPOSE 3001
CMD ["node", "server/index.js"]
